<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Treino A</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    background: #0f172a; color: #e2e8f0;
    margin: 0; padding: 16px; padding-bottom: 100px;
  }
  h1 { text-align: center; font-size: 1.4rem; margin: 8px 0 4px; }
  .sub { text-align: center; color: #94a3b8; font-size: .8rem; margin-bottom: 20px; }

  .progresso-wrap {
    background: #1e293b; border-radius: 12px;
    padding: 14px 16px; margin-bottom: 20px;
  }
  .progresso-topo {
    display: flex; justify-content: space-between;
    font-size: .85rem; margin-bottom: 8px; color: #cbd5e1;
  }
  .barra { height: 8px; background: #334155; border-radius: 4px; overflow: hidden; }
  .barra-preenchida {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #22c55e, #4ade80);
    transition: width .3s;
  }

  .exercicio {
    display: flex; align-items: center; gap: 10px;
    background: #1e293b; border-radius: 10px;
    padding: 10px 12px; margin-bottom: 8px;
    transition: .2s;
  }
  .exercicio.concluido { background: #14532d; opacity: .75; }
  .exercicio.concluido .nome { text-decoration: line-through; color: #86efac; }

  .check {
    width: 26px; height: 26px; flex-shrink: 0;
    border: 2px solid #475569; border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 16px; color: transparent; transition: .2s;
  }
  .check.marcado { background: #22c55e; border-color: #22c55e; color: white; }

  .thumb {
    width: 56px; height: 56px; flex-shrink: 0;
    border-radius: 8px; overflow: hidden;
    background: linear-gradient(135deg, #334155, #1e293b);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
  }

  .info { flex: 1; min-width: 0; }
  .nome { font-weight: 600; font-size: .9rem; display: block; }
  .detalhe { font-size: .72rem; color: #94a3b8; margin-top: 2px; }

  .btn-video, .btn-timer {
    border: none; cursor: pointer;
    border-radius: 8px; padding: 8px 10px;
    font-size: .8rem; font-weight: 600; flex-shrink: 0;
  }
  .btn-video { background: #ef4444; color: white; }
  .btn-timer { background: #334155; color: #e2e8f0; }

  .modal {
    position: fixed; inset: 0; background: rgba(0,0,0,.85);
    display: none; align-items: center; justify-content: center;
    z-index: 100; padding: 20px;
  }
  .modal.ativo { display: flex; }
  .modal-box {
    background: #1e293b; border-radius: 16px;
    padding: 24px; width: 100%; max-width: 340px; text-align: center;
  }
  .timer-display {
    font-size: 4rem; font-weight: 700; font-variant-numeric: tabular-nums;
    margin: 10px 0 20px; color: #4ade80;
  }
  .timer-display.urgente { color: #f87171; }
  .opcoes-tempo { display: flex; gap: 8px; justify-content: center; margin-bottom: 20px; }
  .opcoes-tempo button {
    background: #334155; color: #e2e8f0; border: none;
    padding: 8px 14px; border-radius: 8px; cursor: pointer;
    font-size: .85rem; font-weight: 600;
  }
  .opcoes-tempo button.ativo { background: #22c55e; color: white; }
  .modal-botoes { display: flex; gap: 10px; }
  .modal-botoes button {
    flex: 1; padding: 12px; border: none; border-radius: 10px;
    font-size: .9rem; font-weight: 600; cursor: pointer;
  }
  .btn-pausar { background: #f59e0b; color: white; }
  .btn-fechar { background: #475569; color: white; }

  .reset {
    position: fixed; bottom: 16px; right: 16px;
    background: #ef4444; color: white; border: none;
    padding: 12px 18px; border-radius: 50px;
    font-size: .85rem; font-weight: 600; cursor: pointer;
    box-shadow: 0 4px 12px rgba(0,0,0,.4);
  }
</style>
</head>
<body>

<h1>🏋️ Treino A</h1>
<p class="sub">Toque no ✓ para marcar • no ▶ para ver o vídeo • no ⏱ para descansar</p>

<div class="progresso-wrap">
  <div class="progresso-topo">
    <span>Progresso</span>
    <span id="contador">0 / 7</span>
  </div>
  <div class="barra"><div class="barra-preenchida" id="barra"></div></div>
</div>

<!-- ============================================================
     EXERCÍCIOS — links de BUSCA do YouTube (sempre funcionam)
     Para trocar por vídeo específico: use
     data-video="https://www.youtube.com/watch?v=CODIGO"
     ============================================================ -->
<div id="lista">

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=puxada+frente+na+polia+execução+correta">
    <div class="check" data-idx="0">✓</div>
    <div class="thumb">🏋️</div>
    <div class="info"><span class="nome">Puxada Frente</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=cadeira+extensora+execução+correta">
    <div class="check" data-idx="1">✓</div>
    <div class="thumb">🦵</div>
    <div class="info"><span class="nome">Cadeira Extensora</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=fly+inclinado+com+halteres+execução">
    <div class="check" data-idx="2">✓</div>
    <div class="thumb">💪</div>
    <div class="info"><span class="nome">Fly Inclinado</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=agachamento+livre+execução+correta">
    <div class="check" data-idx="3">✓</div>
    <div class="thumb">🦵</div>
    <div class="info"><span class="nome">Agachamento</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=rosca+direta+com+barra+execução">
    <div class="check" data-idx="4">✓</div>
    <div class="thumb">💪</div>
    <div class="info"><span class="nome">Rosca Direta</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=tríceps+pulley+na+polia+execução">
    <div class="check" data-idx="5">✓</div>
    <div class="thumb">🏋️</div>
    <div class="info"><span class="nome">Tríceps Pulley</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

  <div class="exercicio" data-video="https://www.youtube.com/results?search_query=desenvolvimento+de+ombro+execução">
    <div class="check" data-idx="6">✓</div>
    <div class="thumb">🏋️</div>
    <div class="info"><span class="nome">Desenvolvimento de Ombro</span><span class="detalhe">3 séries × 15 reps</span></div>
    <button class="btn-video">▶</button>
    <button class="btn-timer">⏱</button>
  </div>

</div>

<button class="reset" onclick="resetar()">🔄 Zerar treino</button>

<div class="modal" id="modal">
  <div class="modal-box">
    <div style="color:#94a3b8;font-size:.85rem;">Descanso</div>
    <div class="timer-display" id="timerDisplay">60</div>
    <div class="opcoes-tempo">
      <button onclick="mudarTempo(30, event)">30s</button>
      <button onclick="mudarTempo(45, event)">45s</button>
      <button onclick="mudarTempo(60, event)" class="ativo">60s</button>
    </div>
    <div class="modal-botoes">
      <button class="btn-pausar" id="btnPausar" onclick="togglePausar()">⏸ Pausar</button>
      <button class="btn-fechar" onclick="fecharTimer()">Fechar</button>
    </div>
  </div>
</div>

<script>
/* ============================================================
   JavaScript BLINDADO — se algo falhar, a página continua útil
   ============================================================ */

const STORAGE_KEY = "treinoA_progresso";
let concluidos = {};
try {
  concluidos = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
} catch(e) {
  console.warn("localStorage indisponível — o progresso não será salvo.");
}

function salvar() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(concluidos)); } catch(e) {}
}

// Restaurar estado visual
document.querySelectorAll(".check").forEach(chk => {
  const idx = chk.dataset.idx;
  if (concluidos[idx]) {
    chk.classList.add("marcado");
    chk.parentElement.classList.add("concluido");
  }
});
atualizarProgresso();

// Eventos
const listaEl = document.getElementById("lista");
listaEl.addEventListener("click", (e) => {
  const check = e.target.closest(".check");
  const video = e.target.closest(".btn-video");
  const timer = e.target.closest(".btn-timer");

  if (check) {
    const idx = check.dataset.idx;
    concluidos[idx] = !concluidos[idx];
    check.classList.toggle("marcado", concluidos[idx]);
    check.parentElement.classList.toggle("concluido", concluidos[idx]);
    salvar();
    atualizarProgresso();
  }
  if (video) {
    const url = video.closest(".exercicio").dataset.video;
    window.open(url, "_blank");
  }
  if (timer) abrirTimer();
});

function atualizarProgresso() {
  const total = document.querySelectorAll(".check").length;
  const feitos = Object.values(concluidos).filter(Boolean).length;
  const cont = document.getElementById("contador");
  const barra = document.getElementById("barra");
  if (cont) cont.textContent = `${feitos} / ${total}`;
  if (barra) barra.style.width = `${(feitos / total) * 100}%`;
}

function resetar() {
  if (!confirm("Zerar todo o progresso do treino?")) return;
  concluidos = {};
  try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
  document.querySelectorAll(".check").forEach(c => c.classList.remove("marcado"));
  document.querySelectorAll(".exercicio").forEach(c => c.classList.remove("concluido"));
  atualizarProgresso();
}

// Cronômetro
let tempoTotal = 60, tempoRestante = 60, intervalId = null, pausado = false;
const modal = document.getElementById("modal");
const display = document.getElementById("timerDisplay");
const btnPausar = document.getElementById("btnPausar");

function abrirTimer() {
  tempoRestante = tempoTotal; pausado = false;
  if (btnPausar) btnPausar.textContent = "⏸ Pausar";
  atualizarDisplay();
  if (modal) modal.classList.add("ativo");
  iniciarContagem();
}
function iniciarContagem() {
  clearInterval(intervalId);
  intervalId = setInterval(() => {
    if (pausado) return;
    tempoRestante--; atualizarDisplay();
    if (tempoRestante <= 0) { clearInterval(intervalId); tocarAlerta(); fecharTimer(); }
  }, 1000);
}
function atualizarDisplay() {
  if (!display) return;
  display.textContent = tempoRestante;
  display.classList.toggle("urgente", tempoRestante <= 10);
}
function mudarTempo(seg, ev) {
  tempoTotal = seg; tempoRestante = seg; atualizarDisplay();
  document.querySelectorAll(".opcoes-tempo button").forEach(b => b.classList.remove("ativo"));
  if (ev && ev.target) ev.target.classList.add("ativo");
}
function togglePausar() {
  pausado = !pausado;
  if (btnPausar) btnPausar.textContent = pausado ? "▶ Continuar" : "⏸ Pausar";
}
function fecharTimer() { clearInterval(intervalId); if (modal) modal.classList.remove("ativo"); }
function tocarAlerta() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator(); const gain = ctx.createGain();
    osc.connect(gain); gain.connect(ctx.destination);
    osc.frequency.value = 880; osc.type = "sine";
    gain.gain.setValueAtTime(0.3, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);
    osc.start(); osc.stop(ctx.currentTime + 1.2);
  } catch(e) {}
  if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
}
</script>

</body>
</html>
